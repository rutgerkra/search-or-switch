{
  "manifest_version": 3,
  "name": "Search or Switch",
  "version": "0.1.1",
  "description": "A keyboard-first Firefox popup to switch tabs, open an address, or search. A new tab only when you commit.",
  "permissions": [
    "tabs",
    "history",
    "scripting",
    "search",
    "storage"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Search or Switch",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "windows": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Search or Switch"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "search-or-switch@ffarc.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http: https:; img-src 'self' data:; style-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
