{
  "manifest_version": 3,
  "name": "Search or Switch",
  "version": "0.1.0",
  "description": "A keyboard-first popup to switch tabs, open a URL, or search. A new tab only when you commit.",
  "permissions": ["tabs", "search", "storage"],
  "action": {
    "default_title": "Search or Switch",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Search or Switch"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "search-or-switch@ffarc.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
